<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds Project Location to the Project Classification group that
        ida_sales created on the sale order form.

        Visible and required only when project_type == 'new_project'.
        Cleared automatically by _onchange_project_type_ida_project.

        The Department Short Code is taken from the sale order lines'
        products at confirmation time — no extra field is shown here.
    -->
    <record id="view_sale_order_form_ida_project" model="ir.ui.view">
        <field name="name">sale.order.form.ida.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='base_project_number']" position="after">
                <field
                    name="project_location_id"
                    invisible="project_type != 'new_project'"
                    required="project_type == 'new_project'"
                    options="{'no_create': True}"
                />
            </xpath>

        </field>
    </record>
</odoo>
