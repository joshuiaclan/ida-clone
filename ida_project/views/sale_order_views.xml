<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_project" model="ir.ui.view">
        <field name="name">sale.order.form.ida.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Filter Project Number to only show subprojects that belong to a base project -->
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="domain">[('base_project_id', '!=', False)]</attribute>
            </xpath>

            <!-- Add Base Project field after Project Number, clickable to view sub projects -->
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="base_project_id" readonly="1" options="{'no_create': True, 'no_edit': True}"/>
            </xpath>

        </field>
    </record>
</odoo>
