<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_project" model="ir.ui.view">
        <field name="name">sale.order.form.ida.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Filter Project Number dropdown to only show projects that belong to a base project -->
            <xpath expr="//field[@name='linked_project_id']" position="attributes">
                <attribute name="domain">[('base_project_id', '!=', False)]</attribute>
            </xpath>

            <!-- Show Base Project (ida.base.project) after Project Number — clickable,
                 auto-populated via onchange, also set on new-project confirmation -->
            <xpath expr="//field[@name='linked_project_id']" position="after">
                <field name="base_project_id"
                       string="Base Project"
                       readonly="1"
                       options="{'no_create': True, 'no_edit': True}"/>
            </xpath>

        </field>
    </record>
</odoo>
