<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds Project Location to the project form view.

        The Base Project Number is stored in the standard `name` field —
        no separate field is needed — so only the location is displayed here.
    -->
    <record id="view_project_project_form_ida" model="ir.ui.view">
        <field name="name">project.project.form.ida.project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='description']" position="before">
                <group string="Project Reference" col="2"
                       invisible="not project_location_id">
                    <field name="project_location_id" readonly="True"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
