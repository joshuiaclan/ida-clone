<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_ida_progress" inherit_id="account.report_invoice_document">

        <!--
            Inject a t-set BEFORE the invoice line table so the show_progress
            variable is in scope for both the thead and tbody xpaths below.
            Columns are rendered only when at least one line carries
            contract_amount or percent_complete data.
        -->
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-set="show_progress"
               t-value="any(l.contract_amount or l.percent_complete for l in o.invoice_line_ids)"/>
        </xpath>

        <!-- ── Column headers (after Description, before Unit Price) ───────── -->
        <xpath expr="//th[@name='th_priceunit']" position="before">
            <th t-if="show_progress" class="text-end">Contract Amount</th>
            <th t-if="show_progress" class="text-end">Completed (%)</th>
        </xpath>

        <!-- ── Line cells (after the description cell on every row) ─────────── -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td t-if="show_progress" class="text-end">
                <span t-if="line.contract_amount">
                    <t t-out="formatLang(line.contract_amount, currency_obj=line.currency_id)"/>
                </span>
            </td>
            <td t-if="show_progress" class="text-end">
                <span t-if="line.percent_complete">
                    <t t-out="'%.2f %%' % line.percent_complete"/>
                </span>
            </td>
        </xpath>

    </template>
</odoo>
