<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_ida_progress" inherit_id="account.report_invoice_document">
        <!-- ── Column headers (after Description, before Unit Price) ───────── -->
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th class="text-end">Contract Amount</th>
            <th class="text-end">Percent Complete</th>
        </xpath>

        <!-- ── Line cells (after the description cell on every row) ─────────── -->
        <xpath expr="//td[@name='td_quantity']" position="before">
            <td class="text-end">
                <span t-if="line.contract_amount">
                    <t t-out="line.contract_amount"/>
                </span>
            </td>
            <td class="text-end">
                <span t-if="line.percent_complete">
                    <t t-out="line.percent_complete * 100"/>
                </span>
            </td>
        </xpath>

    </template>
</odoo>
