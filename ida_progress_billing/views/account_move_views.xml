<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ida_progress_billing" model="ir.ui.view">
        <field name="name">account.move.form.ida.progress.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!--
                Add progress billing columns as optional columns in the
                Invoice Lines tab, before Unit Price.
            -->
            <!-- Rename "Price" column to "Current Billed" -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="attributes">
                <attribute name="string">Current Billed</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="before">
                <field
                    name="contract_amount"
                    optional="show"
                    string="Contract Amount"
                    readonly="1"
                />
                <field
                    name="percent_complete"
                    optional="show"
                    widget="percentage"
                    string="Percent to Bill"
                    readonly="1"
                />
                <field
                    name="prior_billed"
                    optional="show"
                    string="Prior Billed"
                    readonly="1"
                />
                <field
                    name="total_billed"
                    optional="show"
                    string="Total Billed"
                    readonly="1"
                />
                <field
                    name="total_percent_billed"
                    optional="show"
                    widget="percentage"
                    string="Total Percent Billed"
                    readonly="1"
                />
                <field
                    name="total_billed_amount"
                    optional="show"
                    string="Total Billed Amount"
                    readonly="1"
                />
            </xpath>

        </field>
    </record>
</odoo>
