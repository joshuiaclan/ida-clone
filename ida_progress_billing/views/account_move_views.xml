<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ida_progress_billing" model="ir.ui.view">
        <field name="name">account.move.form.ida.progress.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!--
                Add Contract Amount, % Complete as optional columns
                in the invoice lines list (Invoice Lines tab).
            -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='price_unit']" position="before">
                <field
                    name="contract_amount"
                    optional="show"
                    string="Contract Amount"
                    readonly="1"
                />
                <field
                    name="percent_complete"
                    optional="show"
                    widget="percentage"
                    string="Percent Complete"
                    readonly="1"
                />
            </xpath>

        </field>
    </record>
</odoo>
