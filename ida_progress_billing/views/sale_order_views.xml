<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_progress_billing" model="ir.ui.view">
        <field name="name">sale.order.form.ida.progress.billing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!--
                Add progress billing columns as optional columns in the order
                lines list, after the Subtotal column.

                percent_complete  – total work done % (informational)
                percent_to_bill   – % to bill this period (bidirectional with Amount to Bill)
                amount_to_bill    – monetary amount to bill (bidirectional with Percent to Bill)
                prior_billed      – sum of previously posted invoice amounts for this line
                total_billed      – prior_billed + amount_to_bill
                total_percent_billed  – total_billed / contract amount %
                total_billed_amount   – contract amount × total_percent_billed
            -->
            <xpath expr="//field[@name='order_line']//field[@name='price_subtotal']" position="after">
                <field
                    name="percent_complete"
                    optional="hide"
                    widget="percentage"
                    string="% Complete"
                    column_invisible="parent.state != 'sale'"
                />
                <field
                    name="percent_to_bill"
                    optional="show"
                    widget="percentage"
                    string="Percent to Bill"
                    column_invisible="parent.state != 'sale'"
                />
                <field
                    name="amount_to_bill"
                    optional="show"
                    string="Amount to Bill"
                    column_invisible="parent.state != 'sale'"
                />
                <field
                    name="prior_billed"
                    optional="show"
                    string="Prior Billed"
                    column_invisible="parent.state != 'sale'"
                    readonly="1"
                />
                <field
                    name="total_billed"
                    optional="show"
                    string="Total Billed"
                    column_invisible="parent.state != 'sale'"
                    readonly="1"
                />
                <field
                    name="total_percent_billed"
                    optional="show"
                    widget="percentage"
                    string="Total Percent Billed"
                    column_invisible="parent.state != 'sale'"
                    readonly="1"
                />
                <field
                    name="total_billed_amount"
                    optional="show"
                    string="Total Billed Amount"
                    column_invisible="parent.state != 'sale'"
                    readonly="1"
                />
            </xpath>

        </field>
    </record>
</odoo>
