<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Is Unpaid Time Off checkbox to the Time Off Type form -->
    <record id="view_hr_holiday_status_form_ida" model="ir.ui.view">
        <field name="name">hr.leave.form.ida</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_type']" position="after">
                <field name="is_unpaid"/>
            </xpath>
        </field>
    </record>
</odoo>
