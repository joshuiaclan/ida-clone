<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_sales" model="ir.ui.view">
        <field name="name">sale.order.form.ida.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Insert Project Classification section above the customer field -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="deal_type" colspan="2" required="1"/>
                <field
                    name="base_project_number" colspan="2"
                    invisible="deal_type != 'new_project'"
                />
                <field
                    name="base_project_id" colspan="2"
                    invisible="deal_type != 'existing_project'"
                    required="deal_type == 'existing_project'"
                />
            </xpath>

        </field>
    </record>
</odoo>
