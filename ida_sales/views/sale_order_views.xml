<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_sales" model="ir.ui.view">
        <field name="name">sale.order.form.ida.sales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Hide quantity column in order lines (optional, hidden by default) -->
            <xpath expr="//field[@name='order_line']//field[@name='product_uom_qty']" position="replace">
                <field name="product_uom_qty" optional="hide" string="Quantity"/>
            </xpath>

            <!-- Insert Project Classification section above the customer field -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="deal_type" colspan="2" required="1"/>
                <field
                    name="base_project_number" colspan="2"
                    invisible="deal_type != 'new_project'"
                />
                <field
                    name="base_project_id" colspan="2"
                    invisible="deal_type == 'new_project' or not deal_type"
                    required="deal_type != 'new_project' and deal_type"
                />
            </xpath>

        </field>
    </record>

    <!-- Agreement Acceptance notebook tab -->
    <record id="view_order_form_ida_sales_acceptance" model="ir.ui.view">
        <field name="name">sale.order.form.ida.sales.acceptance</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Agreement Acceptance" name="ida_agreement_acceptance">
                    <group string="We (Client) accept the terms of this Agreement">
                        <group>
                            <field name="accepted_signature" widget="signature" string="Signature"/>
                            <field name="accepted_printed_name"/>
                            <field name="accepted_email"/>
                            <field name="accepted_title"/>
                            <field name="accepted_date"/>
                        </group>
                        <group>
                            <field name="accepted_legal_entity"/>
                            <field name="accepted_entity_address"/>
                            <field name="accepted_invoice_email"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
