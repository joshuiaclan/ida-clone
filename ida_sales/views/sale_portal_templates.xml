                                        <strong>Legal Entity:</strong>
                                    </td>
                                    <td style="padding:4px 12px;border-bottom:1px solid #dee2e6;">
                                        <input type="text" name="accepted_legal_entity" class="form-control"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555;padding:6px 0;border-bottom:1px solid #dee2e6;vertical-align:middle;">
                                        <strong>Entity Address:</strong>
                                    </td>
