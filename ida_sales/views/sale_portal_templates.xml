                        </div>
                    </form>

                    <!-- Signature canvas JavaScript -->
                    <script type="text/javascript">
                    (function () {
                        var canvas   = document.getElementById('ida-sig-canvas');
                        var ctx      = canvas.getContext('2d');
                        var drawing  = false;
                        var lastX, lastY;

                        ctx.strokeStyle = '#1a1a6e';
                        ctx.lineWidth   = 2;
                        ctx.lineCap     = 'round';
                        ctx.lineJoin    = 'round';

                        // ── Draw mode mouse events ──────────────────────────
                        function pos(e) {
                            var r = canvas.getBoundingClientRect();
                            var scaleX = canvas.width  / r.width;
                            var scaleY = canvas.height / r.height;
                            return {
                                x: (e.clientX - r.left) * scaleX,
                                y: (e.clientY - r.top)  * scaleY
                            };
                        }
                        canvas.addEventListener('mousedown', function (e) {
                            drawing = true;
                            var p = pos(e);
                            lastX = p.x; lastY = p.y;
                            ctx.beginPath();
                            ctx.moveTo(lastX, lastY);
                        });
                        canvas.addEventListener('mousemove', function (e) {
                            if (!drawing) return;
                            var p = pos(e);
                            ctx.lineTo(p.x, p.y);
                            ctx.stroke();
                            lastX = p.x; lastY = p.y;
                        });
                        canvas.addEventListener('mouseup',    function () { drawing = false; });
                        canvas.addEventListener('mouseleave', function () { drawing = false; });

                        // ── Touch events ────────────────────────────────────
                        canvas.addEventListener('touchstart', function (e) {
                            e.preventDefault();
                            var t = e.touches[0];
                            var r = canvas.getBoundingClientRect();
                            drawing = true;
                            lastX = (t.clientX - r.left) * (canvas.width  / r.width);
                            lastY = (t.clientY - r.top)  * (canvas.height / r.height);
                            ctx.beginPath();
                            ctx.moveTo(lastX, lastY);
                        }, { passive: false });
                        canvas.addEventListener('touchmove', function (e) {
                            e.preventDefault();
                            if (!drawing) return;
                            var t = e.touches[0];
                            var r = canvas.getBoundingClientRect();
                            var x = (t.clientX - r.left) * (canvas.width  / r.width);
                            var y = (t.clientY - r.top)  * (canvas.height / r.height);
                            ctx.lineTo(x, y);
                            ctx.stroke();
                            lastX = x; lastY = y;
                        }, { passive: false });
                        canvas.addEventListener('touchend', function () { drawing = false; });

                        // ── Type mode ────────────────────────────────────────
                        var typeInput = document.getElementById('ida-sig-type-text');
                        typeInput.addEventListener('input', function () {
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                            ctx.font      = '52px "Brush Script MT", cursive';
                            ctx.fillStyle = '#1a1a6e';
                            ctx.fillText(this.value, 12, canvas.height * 0.72);
                        });

                        // ── Tabs ─────────────────────────────────────────────
                        document.getElementById('ida-tab-draw').addEventListener('click', function (e) {
                            e.preventDefault();
                            this.classList.add('active');
                            document.getElementById('ida-tab-type').classList.remove('active');
                            document.getElementById('ida-draw-area').style.display = '';
                            document.getElementById('ida-type-area').style.display = 'none';
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                            typeInput.value = '';
                        });
                        document.getElementById('ida-tab-type').addEventListener('click', function (e) {
                            e.preventDefault();
                            this.classList.add('active');
                            document.getElementById('ida-tab-draw').classList.remove('active');
                            document.getElementById('ida-type-area').style.display = '';
                            document.getElementById('ida-draw-area').style.display = 'none';
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                        });

                        // ── Clear ────────────────────────────────────────────
                        document.getElementById('ida-sig-clear').addEventListener('click', function (e) {
                            e.preventDefault();
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                            typeInput.value = '';
                        });

                        // ── Serialize canvas to hidden input before submit ───
                        document.querySelector('form.ida_acceptance_form').addEventListener('submit', function () {
                            document.getElementById('ida-sig-data').value =
                                canvas.toDataURL('image/png').split(',')[1];
                        });
                    })();
                    </script>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
