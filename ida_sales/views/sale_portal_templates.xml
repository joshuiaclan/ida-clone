<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hide the Shipping Address block from the customer portal sale order view.
    -->
    <template
        id="sale_order_portal_content_ida_hide_shipping"
        inherit_id="sale.sale_order_portal_content"
        name="Hide Shipping Address (IDA)">

        <xpath expr="//span[@id='shipping_address']" position="replace"/>

    </template>

    <!--
        Add the Agreement Acceptance section at the bottom of the portal
        sale order page. Shows a fill-in form when not yet accepted, and
        a read-only table once the client has submitted.
    -->
    <template
        id="sale_order_portal_content_ida_acceptance"
        inherit_id="sale.sale_order_portal_content"
        name="Agreement Acceptance Section (IDA)">

        <xpath expr="//div[hasclass('page')]" position="inside">
            <div id="ida_agreement_acceptance" class="mt-5">
                <p class="mb-3">
                    <strong>We (Client) accept the terms of this Agreement</strong>
                </p>

                <!-- ── Already accepted: show read-only table ── -->
                <t t-if="sale_order.accepted_date">
                    <table class="table table-borderless w-100" style="max-width:600px;">
                        <tbody>
                            <tr>
                                <td style="width:160px; color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Signature:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; font-family:cursive; font-size:1.4em; color:#2c3e50;">
                                    <t t-out="sale_order.accepted_signature_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Printed Name:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_printed_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Email Address:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_email"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Title:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_title"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Date:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Legal Entity:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_legal_entity"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6;">
                                    <strong>Entity Address:</strong>
                                </td>
                                <td style="padding:6px 12px; border-bottom:1px solid #dee2e6; color:#e67e22;">
                                    <t t-out="sale_order.accepted_entity_address"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color:#555; padding:6px 0;">
                                    <strong>Invoice Email:</strong>
                                </td>
                                <td style="padding:6px 12px; color:#e67e22;">
                                    <t t-out="sale_order.accepted_invoice_email"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- ── Not yet accepted: show fill-in form ── -->
                <t t-else="">
                    <form
                        method="post"
                        t-attf-action="/my/orders/#{sale_order.id}/accept_terms"
                        class="ida_acceptance_form">

                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="access_token" t-att-value="sale_order.access_token"/>

                        <table class="table table-borderless w-100" style="max-width:600px;">
                            <tbody>
                                <tr>
                                    <td style="width:160px; color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Signature:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="text"
                                            name="accepted_signature_name"
                                            class="form-control"
                                            style="font-family:cursive; font-size:1.2em;"
                                            placeholder="Type your name"
                                            required="required"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Printed Name:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="text"
                                            name="accepted_printed_name"
                                            class="form-control"
                                            required="required"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Email Address:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="email"
                                            name="accepted_email"
                                            class="form-control"
                                            required="required"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Title:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="text"
                                            name="accepted_title"
                                            class="form-control"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Legal Entity:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="text"
                                            name="accepted_legal_entity"
                                            class="form-control"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; border-bottom:1px solid #dee2e6; vertical-align:middle;">
                                        <strong>Entity Address:</strong>
                                    </td>
                                    <td style="padding:4px 12px; border-bottom:1px solid #dee2e6;">
                                        <input
                                            type="text"
                                            name="accepted_entity_address"
                                            class="form-control"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="color:#555; padding:6px 0; vertical-align:middle;">
                                        <strong>Invoice Email:</strong>
                                    </td>
                                    <td style="padding:4px 12px;">
                                        <input
                                            type="email"
                                            name="accepted_invoice_email"
                                            class="form-control"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                Submit
                            </button>
                        </div>
                    </form>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
