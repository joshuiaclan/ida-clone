<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ida_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ida.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Sales Approval" name="sale_approval_settings">
                    <setting string="Require Approval for Sales Quotations"
                             help="Quotations must pass all approval levels before they can be confirmed as Sales Orders.">
                        <field name="sale_approval_required"/>
                        <div invisible="not sale_approval_required" class="mt16">
                            <p class="text-muted">
                                Drag to reorder levels. Approvals proceed
                                from the lowest to the highest level.
                            </p>
                            <field name="sale_approval_level_ids"
                                   nolabel="1"
                                   context="{'default_company_id': company_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"
                                           placeholder="e.g. Manager Approval"
                                           required="1"/>
                                    <field name="approver_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"
                                           domain="[('share', '=', False)]"
                                           required="1"/>
                                    <field name="required_approvals"
                                           string="Required Approvals"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </div>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>
