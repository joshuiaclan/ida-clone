<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view — embedded in the Settings page -->
    <record id="view_sale_approval_level_list" model="ir.ui.view">
        <field name="name">sale.approval.level.list</field>
        <field name="model">sale.approval.level</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Approval Levels">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="e.g. Manager Approval"/>
                <field name="approver_ids" widget="many2many_tags"
                       options="{'no_create': True}"
                       domain="[('share', '=', False)]"/>
                <field name="required_approvals" string="Required Approvals"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_sale_approval_level_form" model="ir.ui.view">
        <field name="name">sale.approval.level.form</field>
        <field name="model">sale.approval.level</field>
        <field name="arch" type="xml">
            <form string="Approval Level">
                <group>
                    <group>
                        <field name="sequence" string="Order"/>
                        <field name="name"/>
                        <field name="required_approvals"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="approver_ids" widget="many2many_tags"
                               domain="[('share', '=', False)]"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
</odoo>
