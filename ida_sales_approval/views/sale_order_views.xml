<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_ida_sales_approval" model="ir.ui.view">
        <field name="name">sale.order.form.ida.sales.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- ── Approval status bar (shown only when approval is active) ── -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="approval_state" widget="statusbar" statusbar_visible="for_approval,approved" invisible="not approval_state"/>
            </xpath>

            <!-- ── Invisible helper fields ─────────────────────────────────── -->
            <xpath expr="//sheet" position="before">
                <field name="approval_required" invisible="1"/>
                <field name="is_current_approver" invisible="1"/>
            </xpath>

            <!-- ── Action buttons ──────────────────────────────────────────── -->
            <xpath expr="//button[@name='action_confirm']" position="before">

                <!-- Submit for Approval: shown when approval required and not yet submitted/approved -->
                <button name="action_submit_approval" string="Submit for Approval" type="object" class="btn-primary" invisible="not approval_required or state not in ('draft', 'sent') or approval_state in ('for_approval', 'approved')"/>

                <!-- Approve: shown only to the current pending approver -->
                <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="approval_state != 'for_approval' or not is_current_approver"/>

                <!-- Refuse: shown only to the current pending approver -->
                <button name="action_refuse" string="Refuse" type="object" class="btn-danger" invisible="approval_state != 'for_approval' or not is_current_approver"/>

                <!-- Reset to Draft: shown when quotation is refused -->
                <button name="action_reset_approval" string="Reset to Draft" type="object" invisible="approval_state != 'refused'"/>

            </xpath>

            <!-- Hide the standard Confirm button when approval is required but not yet granted -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Approvals notebook tab ───────────────────────────────────── -->
            <xpath expr="//notebook" position="inside">
                <page string="Approvals" name="ida_approvals" invisible="not approval_ids">
                    <field name="approval_ids" readonly="1">
                        <list>
                            <field name="level_id" string="Level"/>
                            <field name="approver_id" string="Approver"/>
                            <field name="state" decoration-success="state == 'approved'" decoration-danger="state == 'refused'" decoration-muted="state == 'pending'"/>
                            <field name="date" string="Date"/>
                            <field name="note" string="Note / Reason"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
