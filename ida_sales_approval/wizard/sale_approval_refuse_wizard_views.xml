<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_approval_refuse_wizard_form" model="ir.ui.view">
        <field name="name">sale.approval.refuse.wizard.form</field>
        <field name="model">sale.approval.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Quotation">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="note" placeholder="Enter the reason for refusing this quotation…"/>
                </group>
                <footer>
                    <button name="action_confirm_refusal" string="Confirm Refusal"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
